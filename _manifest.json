{
  "manifest_version": 2,
  "id": "local.mailife-cycle",
  "name": "麦生活 · 周期日历",
  "version": "1.4.0",
  "description": "麦生活独立扩展：周期分层日历、私聊自述历史、角色状态与妊娠状态，以及授权私聊的角色上下文。",
  "author": {
    "name": "joshuapex",
    "url": "https://github.com/joshuapex"
  },
  "urls": {
    "repository": "https://github.com/joshuapex/mailife-cycle-journal"
  },
  "license": "MIT",
  "plugin_type": "extension",
  "host_application": {
    "min_version": "1.3.18",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.19.0",
    "max_version": "2.91.99"
  },
  "dependencies": [
    {
      "type": "plugin",
      "id": "maibot-community.mai-life",
      "version_spec": ">=1.26.6,<2"
    }
  ],
  "capabilities": [
    "config.get_plugin",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "display": {
    "icon": {
      "type": "lucide",
      "value": "calendar",
      "fallback": "calendar",
      "background": "#EDE9FE"
    }
  }
}
